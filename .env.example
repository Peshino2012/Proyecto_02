# --- Base de datos (Postgres) ---
# En producción: URL de Vercel Postgres / Neon / Supabase, etc.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth ---
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="https://tu-app.vercel.app"

# --- Notificaciones push (VAPID) ---
# Generar con: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"

# --- Email SMTP (recordatorios por mail) ---
# Con Gmail: usar una "contraseña de aplicación" (myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Calendario <tu-email@ejemplo.com>"

# --- Cron ---
# Generar con: openssl rand -hex 24
# Debe coincidir con el header Authorization que llama a /api/cron/notify
CRON_SECRET=""
