// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  name                   String?
  passwordHash           String
  // Horario en que no se mandan notificaciones (hora local Argentina, 0-23).
  // Si quietHoursStart > quietHoursEnd, el rango cruza la medianoche.
  quietHoursStart        Int?
  quietHoursEnd          Int?
  defaultReminderMinutes Int?
  // Si las Quests usan las mismas categorías con nombre que los Eventos
  // (Facultad/Laburo/Fe/Personal/Salud/Otro) o su propio set de categorías.
  taskShareEventCategories Boolean          @default(true)
  createdAt              DateTime           @default(now())
  events                 Event[]
  pushSubscriptions      PushSubscription[]
  apiTokens              ApiToken[]
  habits                 Habit[]
  tasks                  Task[]
  progress               UserProgress?
  quickTasks             QuickTask[]
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Event {
  id                       String     @id @default(cuid())
  userId                   String
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                    String
  description              String?
  location                 String?
  startAt                  DateTime
  endAt                    DateTime
  allDay                   Boolean    @default(false)
  color                    String     @default("#4f46e5")
  reminderMinutesBefore    Int?
  notifiedAt               DateTime?
  recurrence               Recurrence @default(NONE)
  recurrenceEndAt          DateTime?
  lastNotifiedOccurrenceAt DateTime?
  // Cuenta regresiva: recordatorio diario entre countdownFrom y countdownTo
  // (YYYY-MM-DD hora Argentina, ambos inclusive), a una hora fija — no repite
  // el evento en sí, solo avisa. countdownTo nunca es posterior al día del
  // evento (se recorta al guardar). Null = sin cuenta regresiva.
  countdownFrom            String?
  countdownTo              String?
  countdownHour            Int?
  countdownMinute          Int?
  // Último día (YYYY-MM-DD hora Argentina) en que se mandó el aviso de
  // cuenta regresiva, para no repetirlo el mismo día.
  countdownLastSentDate    String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([userId, startAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Habit {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  color                String     @default("#16a34a")
  // Solo DAILY o WEEKLY tienen sentido para un hábito.
  recurrence           Recurrence @default(DAILY)
  reminderHour         Int?
  reminderMinute       Int?
  // Fecha (YYYY-MM-DD, hora Argentina) de la última vez que se mandó el
  // recordatorio, para no repetirlo el mismo día.
  lastReminderSentDate String?
  archivedAt           DateTime?
  createdAt            DateTime   @default(now())
  logs                 HabitLog[]

  @@index([userId])
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  // Día local Argentina (YYYY-MM-DD) en que se marcó como cumplido.
  date        String
  completedAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
}

enum TaskStat {
  INTELECTO
  DISCIPLINA
  ESPIRITU
  VITALIDAD
  FUERZA
  OTRO
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  color       String    @default("#0ea5e9")
  stat        TaskStat  @default(OTRO)
  xpReward    Int       @default(15)
  // Objetivo numérico opcional, puramente descriptivo (ej. "100" + "flexiones"),
  // no cambia cómo se completa la quest (sigue siendo un solo tap).
  target      Int?
  targetUnit  String?
  // Quest diaria: reaparece todos los días hasta que se archive, en vez de
  // ser un pendiente puntual con fecha límite.
  repeatDaily Boolean   @default(false)
  // Fecha límite (YYYY-MM-DD hora Argentina) para quests puntuales; null =
  // sin fecha, queda pendiente hasta completarla o archivarla.
  dueDate     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  logs        TaskLog[]

  @@index([userId])
}

model TaskLog {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Día (YYYY-MM-DD hora Argentina) en que se completó: para quests diarias,
  // un log por día; para puntuales, el día en que se tildó.
  date        String
  completedAt DateTime @default(now())
  xpAwarded   Int

  @@unique([taskId, date])
  @@index([taskId])
}

// Progreso del "personaje": nivel, XP y 5 stats que suben según la categoría
// de las quests completadas (estilo Solo Leveling).
model UserProgress {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      Int    @default(1)
  // XP acumulada dentro del nivel actual (se resetea al subir/bajar de nivel).
  xp         Int    @default(0)
  totalXp    Int    @default(0)
  intelecto  Int    @default(0)
  disciplina Int    @default(0)
  espiritu   Int    @default(0)
  vitalidad  Int    @default(0)
  fuerza     Int    @default(0)
  // Días consecutivos con quests diarias incompletas. Al llegar a 3 entra en
  // "zona de penalización" hasta ponerse al día.
  penaltyStrikes         Int      @default(0)
  inPenaltyZone          Boolean  @default(false)
  // Racha: días consecutivos con TODAS las quests diarias completas.
  cleanStreak            Int      @default(0)
  // Último día (YYYY-MM-DD hora Argentina) ya evaluado para penalidad, para
  // no aplicarla dos veces si el cron corre más de una vez el mismo día.
  lastPenaltyCheckedDate String?
  updatedAt              DateTime @updatedAt
}

// Tarea rápida ligada al calendario: distinta de las Quests (sin XP/stats),
// solo un pendiente con fecha y un tilde de hecho/no hecho.
model QuickTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // Día (YYYY-MM-DD hora Argentina) en que cae la tarea.
  date      String
  done      Boolean  @default(false)
  // Recordatorio opcional a una hora fija ese mismo día, solo si sigue sin
  // marcarse como hecha. Null = sin recordatorio.
  reminderHour   Int?
  reminderMinute Int?
  // Último día (YYYY-MM-DD hora Argentina) en que se mandó el recordatorio,
  // para no repetirlo el mismo día.
  lastReminderSentDate String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}
