// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  name                   String?
  passwordHash           String
  // Horario en que no se mandan notificaciones (hora local Argentina, 0-23).
  // Si quietHoursStart > quietHoursEnd, el rango cruza la medianoche.
  quietHoursStart        Int?
  quietHoursEnd          Int?
  defaultReminderMinutes Int?
  createdAt              DateTime           @default(now())
  events                 Event[]
  pushSubscriptions      PushSubscription[]
  apiTokens              ApiToken[]
  habits                 Habit[]
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Event {
  id                       String     @id @default(cuid())
  userId                   String
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                    String
  description              String?
  location                 String?
  startAt                  DateTime
  endAt                    DateTime
  allDay                   Boolean    @default(false)
  color                    String     @default("#4f46e5")
  reminderMinutesBefore    Int?
  notifiedAt               DateTime?
  recurrence               Recurrence @default(NONE)
  recurrenceEndAt          DateTime?
  lastNotifiedOccurrenceAt DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([userId, startAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Habit {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  color                String     @default("#16a34a")
  // Solo DAILY o WEEKLY tienen sentido para un hábito.
  recurrence           Recurrence @default(DAILY)
  reminderHour         Int?
  reminderMinute       Int?
  // Fecha (YYYY-MM-DD, hora Argentina) de la última vez que se mandó el
  // recordatorio, para no repetirlo el mismo día.
  lastReminderSentDate String?
  archivedAt           DateTime?
  createdAt            DateTime   @default(now())
  logs                 HabitLog[]

  @@index([userId])
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  // Día local Argentina (YYYY-MM-DD) en que se marcó como cumplido.
  date        String
  completedAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
}
